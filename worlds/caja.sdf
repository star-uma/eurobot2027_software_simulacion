<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="caja_base">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>0.0005105</ixx><iyy>0.0005105</iyy><izz>0.000121</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision"><geometry><box><size>0.11 0.11 0.3</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.11 0.11 0.3</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

    <!-- No le gusta las imágenes .svg-->
    <!-- Cara Frontal (+X). La caja mide 0.11 de ancho, el borde está en 0.055. Lo ponemos en 0.056 -->
    <visual name="aruco_frente">
      <pose>0.056 0 0 0 0 0</pose>
      <geometry><box><size>0.001 0.08 0.08</size></box></geometry>
      <material>
        <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
        <pbr><metal><albedo_map>materials/textures/aruco_13.png</albedo_map></metal></pbr>
      </material>
    </visual>

    <!-- Cara Trasera (-X) -->
    <visual name="aruco_atras">
      <pose>-0.056 0 0 0 0 0</pose>
      <geometry><box><size>0.001 0.08 0.08</size></box></geometry>
      <material>
        <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
        <pbr><metal><albedo_map>materials/textures/aruco_13.png</albedo_map></metal></pbr>
      </material>
    </visual>

    <!-- Cara Izquierda (+Y) -->
    <visual name="aruco_izq">
      <pose>0 0.056 0 0 0 0</pose>
      <geometry><box><size>0.08 0.001 0.08</size></box></geometry>
      <material>
        <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
        <pbr><metal><albedo_map>materials/textures/aruco_13.png</albedo_map></metal></pbr>
      </material>
    </visual>

    <!-- Cara Derecha (-Y) -->
    <visual name="aruco_der">
      <pose>0 -0.056 0 0 0 0</pose>
      <geometry><box><size>0.08 0.001 0.08</size></box></geometry>
      <material>
        <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
        <pbr><metal><albedo_map>materials/textures/aruco_13.png</albedo_map></metal></pbr>
      </material>
    </visual>
    
    </link>
  </model>
</sdf>
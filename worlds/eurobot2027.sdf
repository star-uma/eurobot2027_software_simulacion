<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="eurobot_2027_world">
    
    <!-- Motores del simulador (Físicas, comandos e interfaz de usuario) -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>

    <!-- Iluminación Global -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ############################################################ -->
    <!-- TAPETE (Suelo del robot en Z=0)                              -->
    <!-- ############################################################ -->
    <model name="tapete_eurobot">
      <!-- Static true el robot no lo mueve, false lo pude coger-->
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.0 2.0</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.0 2.0</size>
            </plane>
          </geometry>
          <material>
            <!-- Luz ambiental blanca para no distorsionar los colores -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
            <metal>
                <!-- La ruta es relativa a la ubicación del archivo .png -->
                <albedo_map>materials/textures/mapa_eurobot2027.png</albedo_map>
            </metal>
            </pbr>
          </material>          
        </visual>
      </link>
    </model>

    <!-- ############################################################ -->
    <!-- BORDES DE MADERA (Estáticos)                               -->
    <!-- ############################################################ -->
    <model name="bordes_mesa">
      <static>true</static>
      
      <!-- Borde Superior (+Y) -->
      <link name="borde_norte">
        <pose>0 1.011 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Inferior (-Y) -->
      <link name="borde_sur">
        <pose>0 -1.011 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Izquierdo (-X) -->
      <link name="borde_oeste">
        <pose>-1.511 0 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.022 2.0 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.022 2.0 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Derecho (+X) -->
      <link name="borde_este">
        <pose>1.511 0 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.022 2.0 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.022 2.0 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- ############################################################ -->
    <!-- CAJAS MÓVILES (Elementos de juego con físicas)             -->
    <!-- ############################################################ -->
    
<!-- Caja Roja (11x11x30 cm, 0.06 kg) -->
    <model name="caja_roja_1">
      <static>false</static>
      <!-- Z=0.15 para que empiece apoyada justo sobre el suelo -->
      <pose>0.5 0.5 0.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>0.0005105</ixx><iyy>0.0005105</iyy><izz>0.000121</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.11 0.11 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.11 0.11 0.3</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
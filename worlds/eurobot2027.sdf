<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="eurobot_2027_world">
    
    <!-- Motores del simulador (Físicas, comandos e interfaz de usuario) -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>

    <!-- Iluminación Global -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ############################################################ -->
    <!-- TAPETE (Suelo del robot en Z=0)                              -->
    <!-- ############################################################ -->
    <model name="tapete_eurobot">
      <!-- Static true el robot no lo mueve, false lo pude coger-->
      <static>true</static>
      <pose>1.5 1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.0 2.0</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3.0 2.0</size>
            </plane>
          </geometry>
          <material>
            <!-- Luz ambiental blanca para no distorsionar los colores -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
            <metal>
                <!-- La ruta es relativa a la ubicación del archivo .png -->
                <albedo_map>materials/textures/mapa_eurobot2027.png</albedo_map>
            </metal>
            </pbr>
          </material>          
        </visual>
      </link>
    </model>

    <!-- ############################################################ -->
    <!-- BORDES DE MADERA (Estáticos)                               -->
    <!-- ############################################################ -->
    <model name="bordes_mesa">
      <static>true</static>
      <pose>1.5 1.0 0 0 0 0</pose>

      <!-- Borde Superior (+Y) -->
      <link name="borde_norte">
        <pose>0 1.011 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Inferior (-Y) -->
      <link name="borde_sur">
        <pose>0 -1.011 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Izquierdo (-X) -->
      <link name="borde_oeste">
        <pose>-1.511 0 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.022 2.0 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.022 2.0 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>

      <!-- Borde Derecho (+X) -->
      <link name="borde_este">
        <pose>1.511 0 0.035 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.022 2.0 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.022 2.0 0.07</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- ############################################################ -->
    <!-- CAJAS MÓVILES (Elementos de juego con físicas)             -->
    <!-- ############################################################ -->
    
    <!-- Pack Izquierdo 1 -->
    <include><name>caja_1</name><pose> 0.6 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_2</name><pose> 0.71 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_3</name><pose> 0.82 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Izquierdo 2 -->
    <include><name>caja_4</name><pose> 1.1 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_5</name><pose> 1.21 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_6</name><pose> 1.32 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Izquierdo 3 -->
    <include><name>caja_7</name><pose> 1.7 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_8</name><pose> 1.81 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_9</name><pose> 1.92 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Izquierdo 4 -->
    <include><name>caja_10</name><pose> 2.2 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_11</name><pose> 2.31 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_12</name><pose> 2.42 1.9 0.15 0 0 0</pose><uri>caja.sdf</uri></include>


    <!-- ############################################################ -->


    <!-- Pack Derecho 1 -->
    <include><name>caja_13</name><pose> 0.6 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_14</name><pose> 0.71 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_15</name><pose> 0.82 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Derecho 2 -->
    <include><name>caja_16</name><pose> 1.1 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_17</name><pose> 1.21 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_18</name><pose> 1.32 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Derecho 3 -->
    <include><name>caja_19</name><pose> 1.7 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_20</name><pose> 1.81 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_21</name><pose> 1.92 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Derecho 4 -->
    <include><name>caja_22</name><pose> 2.2 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_23</name><pose> 2.31 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_24</name><pose> 2.42 0.1 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  

    <!-- ############################################################ -->


    <!-- Pack Central 1 -->
    <include><name>caja_25</name><pose> 1.5 1.6 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_26</name><pose> 1.5 1.49 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_27</name><pose> 1.5 1.38 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  
    <!-- Pack Central 2 -->
    <include><name>caja_28</name><pose> 1.5 0.6 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_29</name><pose> 1.5 0.49 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
    <include><name>caja_30</name><pose> 1.5 0.38 0.15 0 0 0</pose><uri>caja.sdf</uri></include>
  

  
  </world>
</sdf>